  "rules": {
    "internal_pressure_volume_factor": {
      "source_page": 15,
      "definition": "x = 100 A^(3/2) / Vol",
      "pieces": [
        {"condition": "x<0.09", "Kv": 0.85},
        {"condition": "0.09<=x<=3", "Kv": "1.01 + 0.15 log10(x)"},
        {"condition": "x>3", "Kv": 1.085}
      ],
      "otherwise": 1.0
    },
    "terrain_averaging": {
      "source_page": 7,
      "averaging_distance": "xa = max(500 m, 40z)",
      "lag_distance": "xl = 20z",
      "low_rise_height_basis": "For buildings not exceeding 25 m, z is the average roof height h."
    },
    "shielding": {
      "source_page": 8,
      "default": "Ms=1.0 where shielding does not apply or is ignored, including structures over 25 m.",
      "spacing_parameter": "s = ls / sqrt(hs bs)",
      "average_spacing": "ls = h(10/ns + 5)",
      "vegetation": "Trees and vegetation are not credited as shielding."
    },
    "topographic_multiplier": {
      "source_page": 9,
      "A4_or_NZ_above_500m": "Mt = Mh Mlee (1 + 0.00015 E)",
      "A0": "Mt = 0.5 + 0.5 Mh",
      "other_regions": "Mt = max(Mh, Mlee)",
      "minor_hill": "A hill feature with H<10 m may be ignored."
    },
    "action_combination_factor": {
      "source_page": 17,
      "two_contributing_surfaces": 0.9,
      "three_or_more_contributing_surfaces": 0.8,
      "minimum_Ka_times_Kce": 0.8,
      "internal_surface_threshold": "An internal surface is not effective where |Cp,i|<0.4."
    }
  }
