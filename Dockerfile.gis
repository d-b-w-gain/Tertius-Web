FROM python:3.14-slim AS gis-builder

ENV PIP_NO_CACHE_DIR=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/tertius-gis-venv

COPY --from=ghcr.io/astral-sh/uv:0.11.32 /uv /uvx /bin/

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY gis-cache/pyproject.toml gis-cache/uv.lock ./gis-cache/
RUN uv sync --project /app/gis-cache --locked --no-dev


FROM python:3.14-slim AS gis-cache

ENV PATH="/opt/tertius-gis-venv/bin:${PATH}" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    GIS_CACHE_ROOT=/var/lib/tertius-gis

RUN groupadd --gid 1000 app \
    && useradd --uid 1000 --gid app --home-dir /app --shell /usr/sbin/nologin app \
    && apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates libexpat1 \
    && rm -rf /var/lib/apt/lists/* \
    && install -d -o 1000 -g 1000 /var/lib/tertius-gis /tmp/tertius-gis

WORKDIR /app
COPY --from=gis-builder /opt/tertius-gis-venv /opt/tertius-gis-venv
COPY server/gis_cache/ ./server/gis_cache/

USER 1000:1000
EXPOSE 8000

CMD ["uvicorn", "server.gis_cache.app:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
