# Compile jobs started.
# name: compile_started_rate
sum(rate(tertius_compile_started_count[5m]))

# Compile jobs finished.
# name: compile_finished_rate
sum(rate(tertius_compile_finished_count[5m]))

# Compile jobs failed. Should stay zero during healthy smoke runs.
# name: compile_failed_rate
sum(rate(tertius_compile_failed_count[5m]))

# Compile duration p95. Histogram bucket names depend on OpenTelemetry exporter naming.
# name: compile_duration_p95
histogram_quantile(0.95, sum by (le) (rate(tertius_compile_duration_bucket[5m])))

# Compile queue latency p95. Histogram bucket names depend on OpenTelemetry exporter naming.
# name: compile_queue_latency_p95
histogram_quantile(0.95, sum by (le) (rate(tertius_compile_queue_latency_bucket[5m])))

# NATS publish failures. Should stay zero.
# name: nats_publish_failures
sum(rate(tertius_nats_publish_failed_count[5m]))

# Compile time per sandbox phase (startup, design, metadata, export, patch,
# dedup, finish). Shows whether design construction or GLB export dominates.
# name: compile_phase_duration_p95
histogram_quantile(0.95, sum by (le, phase) (rate(tertius_compile_phase_duration_bucket[15m]))) or vector(0)

# Incremental component compile (#312/#313): cached component outcomes by
# bounded cache_status (hit, built, uncacheable, uncached).
# name: component_cache_status_rate
sum by (cache_status) (rate(tertius_compile_component_cache_components_total[15m])) or vector(0)

# Share of component builds served from the cache.
# name: component_cache_hit_ratio
sum(rate(tertius_compile_component_cache_components_total{cache_status="hit"}[1h])) / sum(rate(tertius_compile_component_cache_components_total{cache_status=~"hit|built"}[1h]))

# Component store operations by outcome. unavailable and integrity_failed
# mean compiles ran cold, not that they failed.
# name: component_cache_store_outcome_rate
sum by (operation, outcome) (rate(tertius_compile_component_cache_store_operations_total[15m])) or vector(0)

# p95 time to restore and publish component cache entries.
# name: component_cache_store_duration_p95
histogram_quantile(0.95, sum by (le, operation) (rate(tertius_compile_component_cache_store_duration_bucket[15m]))) or vector(0)
